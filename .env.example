# Hermes Web Voice Assistant — required config
# Copy to .env (or set in Coolify app env) and fill in. NEVER commit real keys.

# STT — Groq Whisper. Get from console.groq.com
GROQ_API_KEY=

# Brain — Hermes api_server (OpenAI-compatible)
API_SERVER_KEY=
API_SERVER_HOST=127.0.0.1
API_SERVER_PORT=8642
BRAIN_MODEL=hermes-agent

# TTS — edge-tts
TTS_VOICE=en-US-AriaNeural

# Optional persona
# SYSTEM_PROMPT=You are a concise voice assistant...

# Port the app listens on
PORT=8000
